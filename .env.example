# Kopiraj u `.env.live` (ignorisan u gitu). Ne upisuj service_role ili access token.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-key>
SUPABASE_PROJECT_REF=<project-ref>

# Samo za CLI deploy; rotiraj nakon dijeljenja i ne prosljeđuj Flutter procesu.
SUPABASE_DB_PASSWORD=<database-password>

FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_DEFINES_FILE=<apsolutna-putanja-do-client-defines.json>
FIREBASE_ADMIN_DEFINES_FILE=<apsolutna-putanja-do-admin-defines.json>

GOOGLE_WEB_CLIENT_ID_BARBERSTUDIOVITEZ=<web-client-id>
GOOGLE_IOS_CLIENT_ID_BARBERSTUDIOVITEZ=<ios-client-id>
